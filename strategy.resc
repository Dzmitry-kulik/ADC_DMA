using sysbus
mach create
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl
machine LoadPlatformDescriptionFromString "gpioPortA: { 0 -> gpioPortA@6 }"
machine LoadPlatformDescriptionFromString "gpioPortB: { 1 -> gpioPortA@8 }"
sysbus LoadELF @/home/dzmitry/PMW_CONFIG.elf
emulation CreateServerSocketTerminal 9876 "uart_tcp" false
connector Connect sysbus.usart1 uart_tcp
start
