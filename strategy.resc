using sysbus
mach create
machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

# Соединяем выход TIM2 CH2 (PA1) со входом TIM3 CH1 (PA6)
machine LoadPlatformDescriptionFromString "gpioPortA: { 1 -> gpioPortA@6 }"

sysbus LoadELF @/home/dzmitry/PMW_CONFIG.elf

sysbus AddWatchpointHook 0x40000810 4 Write """
period_addr = self.GetSymbolAddress('g_measured_period_ticks')
period_val = self.ReadDoubleWord(period_addr)

pulse_addr = self.GetSymbolAddress('g_measured_pulse_ticks')
pulse_val = self.ReadDoubleWord(pulse_addr)

if period_val > 0:
    freq = 16000000.0 / period_val
    duty = (pulse_val * 100.0) / period_val
    print("=============================================================")
    print("[Renode Monitor] Измерение частоты и скважности")
    print("                 Частота:    {0:.0f} Гц".format(freq))
    print("                 Скважность: {0:.2f}%".format(duty))
    print("=============================================================")
else:
    print("[Renode Monitor] Ожидание сигнала...")
"""

showAnalyzer usart1
start
